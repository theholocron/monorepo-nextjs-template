{
  "name": "@theholocron/monorepo-nextjs-template",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:storybook": "turbo run build:storybook --filter=@theholocron/monorepo-nextjs-template-web --",
    "dev": "turbo run dev --concurrency=10 --filter=@theholocron/monorepo-nextjs-template-web",
    "lint": "turbo run lint",
    "prepare": "husky",
    "preview": "turbo run preview --filter=@theholocron/monorepo-nextjs-template-web",
    "release": "semantic-release",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:cypress": "turbo run test:cypress --filter=@theholocron/monorepo-nextjs-template-web",
    "test:storybook": "turbo run test:storybook",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@eslint/js": "catalog:",
    "@semantic-release/changelog": "catalog:",
    "@semantic-release/exec": "catalog:",
    "@semantic-release/git": "catalog:",
    "@semantic-release/github": "catalog:",
    "@theholocron/cli": "catalog:holocron",
    "@theholocron/commitlint-config": "catalog:configs",
    "@theholocron/eslint-config": "catalog:configs",
    "@theholocron/holocron-config": "catalog:configs",
    "@theholocron/holocron-plugin-github": "catalog:holocron",
    "@theholocron/holocron-plugin-vercel": "catalog:holocron",
    "@theholocron/lighthouse-config": "catalog:configs",
    "@theholocron/lint-staged-config": "catalog:configs",
    "@theholocron/prettier-config": "catalog:configs",
    "@theholocron/semantic-release-config": "catalog:configs",
    "@theholocron/skills": "catalog:configs",
    "@theholocron/tsconfig": "catalog:configs",
    "alex": "catalog:",
    "conventional-changelog-conventionalcommits": "catalog:",
    "cypress": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-n": "catalog:",
    "eslint-plugin-simple-import-sort": "catalog:",
    "globals": "catalog:",
    "husky": "catalog:",
    "knip": "catalog:",
    "lint-staged": "catalog:",
    "playwright": "catalog:",
    "prettier": "catalog:",
    "semantic-release": "catalog:",
    "sort-package-json": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  }
}

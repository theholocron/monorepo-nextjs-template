{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": ["pnpm-workspace.yaml", "tsconfig.json"],
  "tasks": {
    "build": {
      "inputs": [
        "src/**",
        "app/**",
        "page/**",
        "public/**",
        "vite.config.ts",
        "next.config.ts",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": ["dist/**", ".next/**", "out/**"],
      "dependsOn": ["^build"]
    },
    "build:storybook": {
      "inputs": ["src/**", "app/**", ".storybook/**", "public/**"],
      "outputs": ["storybook-static/**"],
      "dependsOn": ["^build"]
    },
    "start:storybook": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "preview": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "test:cypress": {},
    "lint": {
      "inputs": ["src/**", "app/**", "page/**", "eslint.config.ts", "eslint.config.js"],
      "outputs": []
    },
    "test": {
      "inputs": ["src/**", "vitest.config.ts", "vitest.setup.ts", "package.json"],
      "outputs": ["test-report.junit.xml"],
      "dependsOn": ["^build"]
    },
    "test:storybook": {
      "inputs": ["src/**", ".storybook/**", "vitest.config.ts", "vitest.setup.ts", "package.json"],
      "outputs": ["test-report.junit.xml"],
      "dependsOn": ["^build"]
    },
    "test:coverage": {
      "inputs": ["src/**", "vitest.config.ts", "vitest.setup.ts", "package.json"],
      "outputs": ["coverage/**"],
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "inputs": ["src/**", "app/**", "page/**", "tsconfig.json"],
      "outputs": [],
      "dependsOn": ["^build"]
    }
  }
}
